# SideTrip MCP — copy to .env and fill in. Never commit a filled-in .env.
# Only VAPI_API_KEY is a secret. Everything else is an id or a phone number.

# --- Required for live calls (get one at https://vapi.ai) ---
VAPI_API_KEY=

# --- Defaults (already point at Brooke + Sean's Vapi number) ---
# Brooke, the voice assistant. Verified 2026-11-12.
VAPI_ASSISTANT_ID=2a6b6f6d-a840-4c31-b555-f81c12bf66d4
# Vapi phone number (405) 444-9356. Verified 2026-11-12.
VAPI_PHONE_NUMBER_ID=a1453415-9fec-4722-9c7f-ef0adac54788

# --- Who SideTrip calls ---
# Example: Sean's phone. Replace with the end user's number.
USER_PHONE=+14054718024

# --- Watcher ---
# JSON file with appointments/bills/deadlines/trips/stores (see examples/joe-cooper.json).
# If unset, the watcher uses the shared list only.
SIDETRIP_INPUTS_FILE=
# Minutes between polls. Default 15.
SIDETRIP_POLL_MINUTES=15
# Where the shared list + notified state live. Default ~/.sidetrip
SIDETRIP_DATA_DIR=
# Set to 1 ONLY when you actually want the watcher to dial real phones.
# Default (unset / anything else) is dry-run: validate, log, never dial.
SIDETRIP_LIVE_CALLS=0

# --- SMS (optional; calls are the default channel) ---
# SIDETRIP_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
